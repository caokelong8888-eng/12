# ===== 服务配置 =====
PORT=3000

# ===== 安全配置 =====
# JWT 签名密钥（生产环境务必替换为足够长的随机字符串）
JWT_SECRET=please-change-me-to-a-long-random-string

# ===== AI 图生图 API（Nano Banana Pro / Gemini 3 Pro Image）=====
# 供应商：gemini（Google Gemini 直连）| aimlapi（AIMLAPI 聚合）| openai（任意 OpenAI 兼容中转站）
# 未配置任何 Key 时，后端自动进入「演示模式」，
# 使用本地图片处理模拟生成效果，便于完整跑通注册/积分/生成/下载全流程。
AI_PROVIDER=gemini

# --- 中转站（gemai.cc 等）Gemini 原生通道 ---
GEMINI_API_KEY=
GEMINI_BASE_URL=https://api.gemai.cc
# 以中转站 /v1/models 返回的实际模型名为准
GEMINI_MODEL=[官]gemini-3.1-flash-image-preview
# 可选：Gemini 图像生成配置（JSON），会合并进 generationConfig，例如：
# GEMINI_IMAGE_CONFIG={"imageConfig":{"aspectRatio":"1:1","imageSize":"1K"}}

# --- GPT Image 2 Pro（同一中转站的 OpenAI 兼容通道）---
# 需要在 .env 填模型名；是否可用以中转站开通为准，服务启动时会自动探测
GPT_IMAGE_MODEL=[官]gpt-image-2-pro
# 可选：独立的中转站地址/Key（默认与 GEMINI 共用）
# GPT_IMAGE_BASE_URL=https://api.gemai.cc
# GPT_IMAGE_API_KEY=
GPT_IMAGE_SIZE=1024x1024
GPT_IMAGE_QUALITY=high
GPT_IMAGE_STYLE=vivid
# 可选：垫图参数名（image / image_urls）
# GPT_IMAGE_IMAGE_FIELD=image
# 可选：附加请求参数（JSON）
# GPT_IMAGE_EXTRA_BODY={}

# --- AIMLAPI 聚合接口（OpenAI 兼容）---
AIMLAPI_API_KEY=
AIMLAPI_MODEL=google/nano-banana-pro-edit
AIMLAPI_ASPECT_RATIO=1:1
AIMLAPI_RESOLUTION=1K

# --- 中转站 / OpenAI 兼容接口 ---
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
# 可选：垫图参数名（gemini 系中转站一般用 image_urls；gpt-image 系用 image）
# OPENAI_IMAGE_FIELD=image_urls
# 可选：附加请求参数（JSON），会合并进请求体，例如 {"size":"1024x1024"}
# OPENAI_EXTRA_BODY={"size":"1024x1024"}

# ===== 新用户注册赠送积分（默认 3 次免费生成额度）=====
SIGNUP_BONUS_CREDITS=3
